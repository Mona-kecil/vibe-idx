{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/og.ts": { "includeFiles": "public/fonts/*.ttf" }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  },
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "https://pub-7982bfb066694e6e8615750132283eba.r2.dev/:path*"
    },
    {
      "source": "/t/:ticker",
      "destination": "/api/page?ticker=:ticker"
    },
    {
      "source": "/((?!assets/|data(?:/|$)|api(?:/|$)|src/|node_modules/|@).*)",
      "destination": "/index.html"
    }
  ]
}

{
  "name": "vibe-idx-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "preview.idx.monosodiums.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/*", "/t/*"],
  },
  "r2_buckets": [
    { "binding": "PUBLIC", "bucket_name": "vibe-idx-public" },
    { "binding": "PRIVATE", "bucket_name": "vibe-idx-private" },
  ],
  "vars": {
    "DEPLOYMENT": "preview",
    "SENTRY_DSN": "https://03fc55665713ed6fef277fe74ebe5ada@o4507632166961152.ingest.us.sentry.io/4512400217735168",
    "WORKOS_CLIENT_ID": "client_01M5KP5949040A7VK88Q06D64E",
  },
  "env": {
    "production": {
      "name": "vibe-idx",
      "routes": [{ "pattern": "idx.monosodiums.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/data/*", "/t/*"],
      },
      "r2_buckets": [
        { "binding": "PUBLIC", "bucket_name": "vibe-idx-public" },
        { "binding": "PRIVATE", "bucket_name": "vibe-idx-private" },
      ],
      "vars": {
        "DEPLOYMENT": "production",
        "SENTRY_DSN": "https://03fc55665713ed6fef277fe74ebe5ada@o4507632166961152.ingest.us.sentry.io/4512400217735168",
        "WORKOS_CLIENT_ID": "client_01M5KP59DT9VA1NXR1KG8WBMS0",
      },
    },
  },
}

{
  "name": "vibe-idx-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "preview.idx.monosodiums.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/*"],
  },
  "r2_buckets": [
    { "binding": "PUBLIC", "bucket_name": "vibe-idx-public" },
    { "binding": "PRIVATE", "bucket_name": "vibe-idx-private" },
  ],
  "vars": { "WORKOS_CLIENT_ID": "client_01M5KP5949040A7VK88Q06D64E" },
}
